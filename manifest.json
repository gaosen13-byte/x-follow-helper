{
  "manifest_version": 3,
  "name": "X 关注助手 / X Follow Helper",
  "description": "在 X 上管理关注关系。Manage follow relationships on X.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["src/i18n.js", "src/scanner.js", "src/actions.js", "src/panel.js", "src/content.js"],
    "css": ["src/panel.css"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "X 关注助手" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
